{
  "name": "claude-of-alexandria-mcp-worker",
  "version": "5.0.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export-d1": "tsx scripts/export-d1.ts",
    "seed-d1": "bash scripts/seed-d1.sh",
    "backfill:ot-structure": "bash scripts/backfill-ot-structure.sh",
    "backfill:transliteration": "bash scripts/backfill-transliteration.sh",
    "backfill:lemma-translit": "bash scripts/backfill-lemma-translit.sh",
    "backfill:theographic-places": "bash scripts/backfill-theographic-places.sh",
    "backfill:vocabulary": "bash scripts/regenerate-vocabulary.sh",
    "generate-cross-references": "tsx scripts/generate-cross-references.ts",
    "generate-notices": "tsx scripts/generate-notices.ts",
    "check-notices": "tsx scripts/generate-notices.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hebrew-transliteration": "2.11.0",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
