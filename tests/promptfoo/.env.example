# Evaluations run entirely on a Claude Code subscription — no paid API keys.
#
# Auth: a subscription OAuth token, created with `claude setup-token`.
# The custom Agent SDK providers (providers/sdk-*.mjs) strip ANTHROPIC_API_KEY
# from the child environment, so they can never fall back to paid API usage —
# generator AND grader both authenticate via this token.
CLAUDE_CODE_OAUTH_TOKEN=
