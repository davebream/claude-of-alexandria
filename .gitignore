# Private development notes and specifications
.ai/

# Ephemeral development artifacts (plans, reports, reviews, research) are local-only.
# Use docs/* (not docs/) so git can traverse in and re-include docs/adr below.
docs/*
!docs/mcp-v4-migration.md
!docs/mcp-v5-migration.md
# ...but Architecture Decision Records are part of the repo — they are the public,
# permanent rationale for decisions (see CLAUDE.md "Where to Put Things").
!docs/adr/
!docs/incidents/
!docs/incidents/**
!docs/data-provenance/
!docs/data-provenance/**

# Git worktrees
.worktrees/

# Claude Code local configuration (settings.json is shared, settings.local.json is personal)
.claude/settings.local.json
!.claude/settings.json

# Session handoff notes — machine-local, may reference local paths and
# in-flight state. Never committed to this public repo.
.claude/session.md

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node modules (if we add JS tooling later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if we add Python tools later)
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Temporary files
*.tmp
*.temp
.cache/

# Environment variables
.env
.env.local
.env.backup*
.env.oauth

# Ephemeral text dumps (root-level only)
/*.txt

# Build outputs (if we add build steps)
dist/
build/
*.egg-info/

# Test outputs
.pytest_cache/
.coverage
htmlcov/
tests/promptfoo/results/

# Wrangler local state (dev server, cache, sqlite)
server/.wrangler/

# D1 seed files (generated — do not commit)
server/d1-seed/

# Downloaded data (re-downloadable, not committed)
server/scripts/ot_in_nt_refs.json
server/scripts/cross_references.txt
server/scripts/openbible-crossrefs.zip

# Merge report (build artifact, regenerable)
server/scripts/merge-report.json

# Betterleaks binary cache
.bin/

# Script output (generated proposals — do not commit)
server/scripts/output/
.build-checkpoint.json

# kombajn CLI — pipeline artifacts and local config are not part of the
# distributed project (see CLAUDE.md: no private tooling in a public repo).
.kombajn/
